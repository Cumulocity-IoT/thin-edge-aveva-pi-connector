# =============================================================================
# PI Historian Flow — configuration template
# Copy this file to params.toml and fill in your values.
# The flow reads params.toml automatically; params.toml.template is only for
# defaults — it is NOT overwritten when the flow package is updated.
# =============================================================================

# PI Web API connection — used only when /etc/tedge/c8y/pi_config.json does not exist.
# Prefer managing these values via pi_config.json (updated remotely via Cumulocity config management).
pi_url      = "http://host.containers.internal:8080/piwebapi"
pi_user     = "piuser"
pi_password = "cGlwYXNzd29yZA=="   # base64-encode your password first

# List of PI tag names to poll every 60 seconds.
# Used only when /etc/tedge/c8y/datapoints.json does not exist.
# Prefer managing datapoints via datapoints.json (updated remotely via Cumulocity config management).
datapoints = ["REACTOR01.TEMP","PUMP02.FLOW","COMPRESSOR.PRESSURE","MOTOR01.SPEED","TANK01.LEVEL"]

# Cumulocity measurement type (becomes the JSON fragment key)
measurement_type = "pi_historianMeasurement"

# MQTT topic to publish measurements — direct C8y MQTT API
output_topic = "c8y/measurement/measurements/create"

# MQTT twin topic prefix for device metadata (published once on startup)
metadata_topic = "te/device/main///twin"

# PI Web API query filter appended to the dataserver Points link
query_filter = "?query=PointType:Float32&namefilter="

# Set to true to enable verbose console logging
debug = false
