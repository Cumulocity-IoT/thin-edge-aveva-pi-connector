{
  "name": "Python Microservice Dev Container",
  "dockerFile": "Dockerfile",

  "privileged": true,

  "runArgs": [
    "--add-host=host.containers.internal:host-gateway"
  ],

  "mounts": [
    "source=${localWorkspaceFolder}/mnt,target=/etc/tedge/c8y,type=bind"
  ],

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false,
      "enableNonRootDocker": "true",
      "dockerDashComposeVersion": "v2"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "installGlobals": "esbuild"
    }
  },

  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },

  "postCreateCommand": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.terminal.useEnvFile": true,
        "python.envFile": "${workspaceFolder}/.env",
        "markdown.preview.breaks": true,
        "remote.localPortHost": "localhost"
      }
    }
  },

  "remoteUser": "vscode"
}