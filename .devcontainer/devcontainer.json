{
  "name": "Python Microservice Dev Container",
  "dockerFile": "Dockerfile",

  "runArgs": [
    "--add-host=host.docker.internal:host-gateway"
  ],

  "mounts": [
    "source=/etc/tedge/c8y,target=/etc/tedge/c8y,type=bind"
  ],

  "containerEnv": {
    "PYTHONPATH": "/workspaces",
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },

  "postCreateCommand": "python3 -m venv .venv || true && . .venv/bin/activate && python -m pip install --upgrade pip && pip install -r requirements.txt",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true,
        "python.terminal.useEnvFile": true,
        "python.envFile": "${workspaceFolder}/.env"
      }
    }
  },

  "remoteUser": "vscode"
}